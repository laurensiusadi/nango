# Self-hosted Nango env — copy to self-hosted/.env and fill in.
# `.env` is gitignored; never commit real secrets.

# --- Image version ---------------------------------------------------------
# Pin to a released tag. Find current tags at:
#   https://hub.docker.com/r/nangohq/nango-server/tags
# auto-update.sh bumps this for you.
NANGO_IMAGE_TAG=hosted

# --- Encryption ------------------------------------------------------------
# REQUIRED. Generate once with: openssl rand -base64 32
# WARNING: once set and data is encrypted, changing this breaks all stored
# credentials permanently. Treat like the Workmode storage master key.
NANGO_ENCRYPTION_KEY=

# --- Database --------------------------------------------------------------
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=change-me-strong-password
NANGO_DB_NAME=nango
NANGO_DB_HOST=nango-db
NANGO_DB_SSL=false

# --- Public URLs (behind nginx) --------------------------------------------
# The externally reachable hostnames. Match these to the nginx server blocks.
NANGO_SERVER_URL=https://nango.workmode.now
NANGO_PUBLIC_SERVER_URL=https://nango.workmode.now
NANGO_PUBLIC_CONNECT_URL=https://connect.nango.workmode.now

# --- Dashboard auth (basic auth gate) --------------------------------------
FLAG_AUTH_ENABLED=true
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=change-me-strong-password

# --- Ports (internal; nginx proxies to these) ------------------------------
SERVER_PORT=3003
CONNECT_UI_PORT=3009

# --- Misc ------------------------------------------------------------------
FLAG_SERVE_CONNECT_UI=true
LOG_LEVEL=info
NANGO_LOGS_ENABLED=false
