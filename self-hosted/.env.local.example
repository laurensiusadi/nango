# Local self-host env — copy to self-hosted/.env.local and fill in.
# Used with docker-compose.local.yaml to run the deployed image locally against
# the dev backing DB/redis (dev/docker-compose.dev.yaml).

# Pin to the same tag deployed in prod for parity.
NANGO_IMAGE_TAG=hosted-0.70.6

# MUST match the NANGO_ENCRYPTION_KEY in the repo-root dev .env, or stored
# integration credentials won't decrypt.
NANGO_ENCRYPTION_KEY=<copy from ../.env>

NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=nango

SERVER_PORT=3003
FLAG_AUTH_ENABLED=false
LOG_LEVEL=info
